{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run :*)",
      "Bash(node qa-system/tools/:*)",
      "Bash(npx playwright :*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/qa-system/tools/system/gate-hook.js\"",
            "timeout": 15,
            "statusMessage": "Kiểm tra cổng ASK..."
          }
        ]
      }
    ]
  }
}
