{
  "name": "cw-agent-antigravity",
  "version": "1.0.0",
  "private": true,
  "description": "Bo QA Agent (analyst / test-design / test-data / exploratory / ui-review) + tien ich doi tai lieu .docx sang .md cho INPUT/",
  "scripts": {
    "init": "node qa-system/tools/system/init.js",
    "test": "node --test \"qa-system/tools/__tests__/*.test.js\"",
    "start": "node qa-system/tools/system/start.js",
    "intake": "node qa-system/tools/intake/intake.js",
    "intake:bulk": "node qa-system/tools/intake/bulk-intake.js",
    "convert": "node qa-system/tools/intake/convert.js",
    "knowledge:new": "node qa-system/tools/knowledge/new-knowledge.js",
    "knowledge:init": "node qa-system/tools/knowledge/bootstrap-knowledge.js",
    "knowledge:conflicts": "node qa-system/tools/knowledge/conflict-detector.js",
    "knowledge:sync": "node qa-system/tools/knowledge/sync-answers.js",
    "testcases:merge": "node qa-system/tools/testcase/merge-testcases.js",
    "testcases:export": "node qa-system/tools/testcase/export-testcases.js",
    "data:gen": "node qa-system/tools/testdata/generate-dataset.js",
    "jira:pull": "node qa-system/tools/jira/jira-client.js pull",
    "jira:push": "node qa-system/tools/jira/jira-client.js push",
    "jira:sync": "node qa-system/tools/jira/jira-client.js sync",
    "jira:mcp": "node qa-system/tools/jira/mcp-server.js",
    "status": "node qa-system/tools/system/status.js",
    "map:sync": "node qa-system/tools/system/sync-system-map.js",
    "agent:check": "node qa-system/tools/system/agent-doctor.js",
    "gate": "node qa-system/tools/system/gate.js check",
    "gate:audit": "node qa-system/tools/system/gate.js audit",
    "readiness": "node qa-system/tools/system/readiness.js",
    "workflow": "node qa-system/tools/system/workflow.js",
    "lint": "node qa-system/tools/system/lint-deliverables.js",
    "test:e2e": "playwright test -c automation/playwright.config.ts",
    "test:e2e:headed": "playwright test -c automation/playwright.config.ts --headed",
    "test:e2e:ui": "playwright test -c automation/playwright.config.ts --ui",
    "test:report": "playwright show-report automation/playwright-report"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "js-yaml": "^5.4.2",
    "mammoth": "^1.12.1",
    "pdf-parse": "^2.4.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3"
  }
}
