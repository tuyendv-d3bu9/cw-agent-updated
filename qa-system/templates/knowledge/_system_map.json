{
  "system_name": "CW QA Agent Ecosystem",
  "version": "2.0.0",
  "last_updated": "2026-09-18",
  "ssot_policy": "Tri thức trong knowledge/ là tối cao. CẤM đọc dò từng file, tra cứu bảng routing_table để mở đúng file đích.",
  "project_conventions": {
    "project_name": "<Tên Dự Án>",
