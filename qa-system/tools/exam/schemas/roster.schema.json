{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cw-agent/exam/roster/1.0.0",
  "description": "$GRADER_PRIVATE/<exam-id>/roster.json — private list of students; discovery trusts this list, never the branch pattern alone.",
  "type": "object",
  "additionalProperties": false,
  "required": ["exam_id", "students"],
  "properties": {
    "exam_id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "students": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["student_id", "display_name"],
        "properties": {
          "student_id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 },
          "display_name": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    }
  }
}
