{
  "_comment": [
    "Kiểu dữ liệu sinh GIẢ của ngành y tế: mọi giá trị mang tiền tố SYN, không gắn với người thật.",
    "types.<tên> = { generator: <engine của generate-dataset>, defaults: { tham số } }.",
    "enums.encounter_status theo mã FHIR Encounter.status (https://www.hl7.org/fhir/encounter.html); enums.claim_status theo Claim.status (https://www.hl7.org/fhir/claim.html).",
    "Ràng buộc nghiệp vụ của dự án (độ dài mã, giá trị hợp lệ) vẫn chép từ Field Map, không lấy ở đây."
  ],
  "types": {
    "synthetic_patient_id": {
      "generator": "code",
      "defaults": { "prefixes": ["SYN-PAT-"], "values": ["0001", "0002", "0003", "0004", "0005"] }
    },
    "synthetic_encounter_id": {
      "generator": "code",
      "defaults": { "prefixes": ["SYN-ENC-"], "values": ["0001", "0002", "0003", "0004", "0005"] }
    },
    "synthetic_claim_id": {
      "generator": "code",
      "defaults": { "prefixes": ["SYN-CLM-"], "values": ["0001", "0002", "0003", "0004", "0005"] }
    },
    "synthetic_patient_email": {
      "generator": "email",
      "defaults": { "prefix": "syn.patient", "domain": "example.com" }
    },
    "encounter_date": {
      "generator": "date",
      "defaults": { "year": 2026 }
    },
    "encounter_status": {
      "generator": "enum",
      "defaults": {
        "values": ["planned", "in-progress", "on-hold", "discharged", "completed", "cancelled", "discontinued", "entered-in-error", "unknown"]
      }
    },
    "claim_status": {
      "generator": "enum",
      "defaults": { "values": ["active", "cancelled", "draft", "entered-in-error"] }
    }
  },
  "enums": {
    "encounter_status": ["planned", "in-progress", "on-hold", "discharged", "completed", "cancelled", "discontinued", "entered-in-error", "unknown"],
    "claim_status": ["active", "cancelled", "draft", "entered-in-error"]
  }
}
