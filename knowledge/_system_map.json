{
  "system_name": "CW QA Agent Ecosystem",
  "version": "2.0.0",
  "last_updated": "2026-10-02",
  "ssot_policy": "Tri thức trong knowledge/ là tối cao. CẤM đọc dò từng file, tra cứu bảng routing_table để mở đúng file đích.",
  "project_conventions": {
    "project_name": "<Tên Dự Án>",
    "currency": "VNĐ",
    "timezone": "Asia/Ho_Chi_Minh (GMT+7)",
    "rule_file": "knowledge/_project.md",
    "glossary_file": "knowledge/_glossary.md",
    "template_file": "knowledge/_template.md"
  },
  "routing_table": {
    "view_project_rules": "knowledge/_project.md",
    "view_glossary_terms": "knowledge/_glossary.md",
    "qa_standards_fact": "agents/core/QA_STANDARD.md",
    "master_constitution": "AGENTS.md",
    "orchestrator_agent": "agents/qa-lead/AGENT.md",
    "tasks_progress_command": "npm run status",
    "convert_docx_command": "npm run convert",
    "create_feature_knowledge_command": "npm run knowledge:new <slug>",
    "merge_testcases_command": "npm run testcases:merge <slug>",
    "sync_system_map_command": "npm run map:sync",
    "generate_bug_report": "agents/qa-reporter/skills/gen-bug-report.md",
    "generate_daily_summary": "agents/qa-reporter/skills/gen-daily-summary.md",
    "generate_readiness_report": "agents/qa-readiness-evaluator/skills/gen-readiness-report.md",
    "web_journey_discovery": "agents/qa-exploratory/skills/web-journey-discovery.md",
    "flow_clustering": "agents/qa-automation/skills/flow-clustering.md",
    "pom_generator": "agents/qa-automation/skills/pom-generator.md",
    "test_runner_evidence": "agents/qa-automation/skills/test-runner-evidence.md",
    "jira_mcp_server": "agents/tools/jira-mcp-server.js",
    "jira_mcp_guide": "agents/integrations/jira-mcp-guide.md",
    "template_input_dir": "INPUT/_template/",
    "template_run_dir": "OUTPUT/_template_run/",
    "system_upgrade_governance": "agents/qa-lead/skills/system-upgrade-governance.md",
    "agent_extension_guide": "agents/templates/README.md",
    "agent_template": "agents/templates/AGENT.md",
    "skill_template": "agents/templates/skills/ten-skill.md",
    "shopgo_ui_map": "knowledge/features/shopgo-ui-map.md",
    "graduation_runbook": "agents/workflows/run-graduation.md",
    "integrity_check_command": "npm run agent:check",
    "impact_analysis_command": "npm run agent:check -- --impact <agent>"
  },
  "specialized_agents": {
    "qa_lead": {
      "path": "agents/qa-lead/AGENT.md",
      "role": "Tổng chỉ huy điều phối, giao việc, nghiệm thu; sở hữu skill system-upgrade-governance để nâng cấp chính hệ thống agent",
      "skills_path": "agents/qa-lead/skills/"
    },
    "qa_analyst": {
      "path": "agents/qa-analyst/AGENT.md",
      "skills_path": "agents/qa-analyst/skills/",
      "role": "01->04: Phân tích yêu cầu, kẽ hở 06W, viewpoint, test idea"
    },
    "qa_test_design": {
      "path": "agents/qa-test-design/AGENT.md",
      "skills_path": "agents/qa-test-design/skills/",
      "role": "05->06: Sinh test case 8 trường, chia lô, rà soát độ phủ"
    },
    "qa_test_data": {
      "path": "agents/qa-test-data/AGENT.md",
      "skills_path": "agents/qa-test-data/skills/",
      "role": "09->12: Sinh data class, dataset thực tế, boundary dataset, traceability"
    },
    "qa_ui_review": {
      "path": "agents/qa-ui-review/AGENT.md",
      "skills_path": "agents/qa-ui-review/skills/",
      "role": "08: Phân tích bố cục giao diện, màu sắc, font chữ, accessibility (Vision)"
    },
    "qa_exploratory": {
      "path": "agents/qa-exploratory/AGENT.md",
      "skills_path": "agents/qa-exploratory/skills/",
      "role": "07: Thăm dò không kịch bản và mò web quét DOM"
    },
    "qa_reporter": {
      "path": "agents/qa-reporter/AGENT.md",
      "skills_path": "agents/qa-reporter/skills/",
      "role": "13: Chuẩn hóa bug report 7 trường, daily summary 4 section"
    },
    "qa_automation": {
      "path": "agents/qa-automation/AGENT.md",
      "skills_path": "agents/qa-automation/skills/",
      "role": "Gom cụm luồng hành trình, sinh POM và thực thi Playwright E2E bắt evidence"
    },
    "qa_readiness_evaluator": {
      "path": "agents/qa-readiness-evaluator/AGENT.md",
      "skills_path": "agents/qa-readiness-evaluator/skills/",
      "role": "Đánh giá mức độ sẵn sàng kiểm thử (Design-time QA Readiness) trước khi chuyển sang Test Automation"
    }
  },
  "features_inventory": {},
  "sut": {
    "name": "ShopGo",
    "url": "https://cwshopgo.github.io",
    "type": "React SPA tĩnh (Vite build), host GitHub Pages, không có backend/API",
    "routing": "KHÔNG có router - đổi màn bằng state activeTab. CẤM page.goto(path) trong automation.",
    "ui_map": "knowledge/features/shopgo-ui-map.md",
    "storage_keys": [
      "shopgo_user",
      "shopgo_orders",
      "shopgo_sqlite_orders_v1",
      "shopgo_sqlite_queries_log"
    ]
  }
}