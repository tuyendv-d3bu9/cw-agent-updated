# ==========================================
# CẤU HÌNH KẾT NỐI JIRA & REDMINE (TÙY CHỌN)
# ==========================================
# Sao chép file này thành .env và điền thông tin của dự án bạn.
# 
# Hệ thống hỗ trợ 3 phương thức làm việc với Jira:
# 1. FILE CSV IMPORT (Khuyến nghị cho gói Jira Free): Tự động sinh `export_jira_xray.csv`.
# 2. REST API DIRECT: Gọi trực tiếp qua lệnh `npm run jira:pull` và `npm run jira:push`.
# 3. MODEL CONTEXT PROTOCOL (Jira MCP): Khởi động server MCP `npm run jira:mcp` hoặc
#    kết nối trực tiếp với Antigravity IDE / Cursor qua `.agents/mcp_config.json`.
#
# Cách lấy JIRA_API_TOKEN miễn phí (chỉ mất 30 giây):
# Truy cập: https://id.atlassian.com/manage-profile/security/api-tokens -> "Create API token"

# 1. Jira Cloud / Jira Server (Dùng chung cho cả REST API & Jira MCP Server)
JIRA_HOST=https://your-domain.atlassian.net
JIRA_EMAIL=qa-lead@shopgo.vn
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=SHOPGO
JIRA_TEST_ISSUE_TYPE=Test

# 2. Redmine (nếu sử dụng Redmine)
REDMINE_HOST=https://redmine.your-company.com
REDMINE_API_KEY=your_redmine_api_key_here
REDMINE_PROJECT_ID=shopgo
